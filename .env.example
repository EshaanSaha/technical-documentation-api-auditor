# Copy to .env and adjust if needed. No API keys are required: all processing is local.

# Backend (FastAPI)
AUDITOR_API_HOST=127.0.0.1
AUDITOR_API_PORT=8000

# Frontend (Streamlit)
AUDITOR_UI_PORT=8501
# URL the Streamlit frontend uses to reach the backend
AUDITOR_API_URL=http://127.0.0.1:8000

# Storage
AUDITOR_DB_PATH=data/auditor.db
AUDITOR_UPLOAD_DIR=data/uploads
AUDITOR_MAX_UPLOAD_MB=20

# NLP models (local paths / package names)
AUDITOR_EMBEDDING_MODEL_DIR=data/models/all-MiniLM-L6-v2
AUDITOR_SPACY_MODEL=en_core_web_sm

# Logging
AUDITOR_LOG_LEVEL=INFO

