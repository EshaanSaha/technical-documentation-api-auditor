{
  "openapi": "3.0.3",
  "info": {
    "title": "MedCore Clinical EHR & Patient Portal API",
    "version": "4.1.0",
    "description": "HL7/FHIR-aligned clinical API for managing electronic health record (EHR) patient demographics, outpatient appointments, e-prescriptions, diagnostic lab panels and insurance claims."
  },
  "servers": [
    {
      "url": "https://api.medcorehealth.org/v4"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Patients"
    },
    {
      "name": "Appointments"
    },
    {
      "name": "Prescriptions"
    },
    {
      "name": "Laboratories"
    },
    {
      "name": "Claims"
    }
  ],
  "paths": {
    "/patients": {
      "get": {
        "tags": [
          "Patients"
        ],
        "operationId": "searchPatients",
        "summary": "Search patient records",
        "description": "Searches clinical patient charts by medical record number (MRN), family name or date of birth within the authenticated facility.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "patient_mrn",
            "in": "query",
            "required": false,
            "description": "Exact hospital medical record number (MRN).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_of_birth",
            "in": "query",
            "required": false,
            "description": "Patient date of birth in ISO 8601 YYYY-MM-DD format.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "X-Facility-ID",
            "in": "header",
            "required": true,
            "description": "Identifier of the hospital or outpatient clinic facility performing the lookup.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching patient charts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Patients"
        ],
        "operationId": "registerPatient",
        "summary": "Register a new patient",
        "description": "Creates a new master patient index (MPI) chart and assigns a permanent medical record number.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Newly registered patient chart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "A patient chart with the same MRN or national health identifier already exists."
          }
        }
      }
    },
    "/patients/{patient_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PatientId"
        }
      ],
      "get": {
        "tags": [
          "Patients"
        ],
        "operationId": "getPatient",
        "summary": "Retrieve patient chart",
        "description": "Retrieves full patient demographics, active allergies, primary care provider and insurance coverage.",
        "responses": {
          "200": {
            "description": "Patient chart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Patients"
        ],
        "operationId": "updatePatientContact",
        "summary": "Update patient demographics",
        "description": "Updates contact phone, residential address or primary insurance policy on an existing patient chart.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "insurance_policy": {
                    "$ref": "#/components/schemas/InsurancePolicy"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated patient chart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/appointments": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "operationId": "listAppointments",
        "summary": "List clinical appointments",
        "description": "Returns scheduled, checked-in and completed outpatient encounters filtered by clinician, department or date.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "provider_id",
            "in": "query",
            "required": false,
            "description": "Filter appointments for a specific attending clinician UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "clinic_date",
            "in": "query",
            "required": false,
            "description": "Filter appointments scheduled on this calendar date (YYYY-MM-DD).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of clinical appointments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Appointments"
        ],
        "operationId": "bookAppointment",
        "summary": "Book an appointment",
        "description": "Books an outpatient or telehealth appointment slot between a patient and an attending clinician.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booked appointment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            }
          },
          "409": {
            "description": "The clinician is already booked for the requested time slot."
          }
        }
      }
    },
    "/appointments/{appointment_id}/reschedule": {
      "patch": {
        "tags": [
          "Appointments"
        ],
        "operationId": "rescheduleAppointment",
        "summary": "Reschedule an appointment",
        "description": "Moves an existing appointment to a new start time with the same clinician and sends an automated SMS confirmation to the patient.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AppointmentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "new_start_time",
                  "reason"
                ],
                "properties": {
                  "new_start_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rescheduled appointment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appointment"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/appointments/{appointment_id}": {
      "delete": {
        "tags": [
          "Appointments"
        ],
        "operationId": "cancelAppointment",
        "summary": "Cancel an appointment",
        "description": "Cancels a scheduled outpatient appointment and releases the clinician's calendar slot back to the booking pool.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AppointmentId"
          }
        ],
        "responses": {
          "204": {
            "description": "Appointment cancelled."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/prescriptions": {
      "get": {
        "tags": [
          "Prescriptions"
        ],
        "operationId": "listPrescriptions",
        "summary": "List active prescriptions",
        "description": "Returns active and historical medication orders for a given patient.",
        "parameters": [
          {
            "name": "patient_id",
            "in": "query",
            "required": true,
            "description": "Unique UUID identifier of the patient.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "active_only",
            "in": "query",
            "required": false,
            "description": "When true, excludes expired and discontinued medication orders.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Medication prescriptions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrescriptionList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Prescriptions"
        ],
        "operationId": "createPrescription",
        "summary": "Issue an e-prescription",
        "description": "Transmits an electronic medication prescription (eRx) to the patient's designated retail or mail-order pharmacy after checking drug-allergy interactions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrescriptionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Issued electronic prescription.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prescription"
                }
              }
            }
          },
          "422": {
            "description": "Severe drug-allergy or drug-drug interaction detected."
          }
        }
      }
    },
    "/prescriptions/{prescription_id}/refill": {
      "post": {
        "tags": [
          "Prescriptions"
        ],
        "operationId": "authorizeRefill",
        "summary": "Authorize a prescription refill",
        "description": "Authorizes an additional dispensing refill on an existing non-controlled medication order.",
        "parameters": [
          {
            "name": "prescription_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the prescription.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "additional_refills",
                  "authorizing_provider_id"
                ],
                "properties": {
                  "additional_refills": {
                    "type": "integer"
                  },
                  "authorizing_provider_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated prescription record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prescription"
                }
              }
            }
          }
        }
      }
    },
    "/labs/orders": {
      "post": {
        "tags": [
          "Laboratories"
        ],
        "operationId": "submitLabOrder",
        "summary": "Submit a diagnostic lab order",
        "description": "Submits a clinical laboratory requisition (CBC, metabolic panel, lipid panel) to the reference laboratory queue.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabOrderCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Lab requisition accepted for specimen collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabReport"
                }
              }
            }
          }
        }
      }
    },
    "/labs/orders/{lab_order_id}": {
      "get": {
        "tags": [
          "Laboratories"
        ],
        "operationId": "getLabReport",
        "summary": "Retrieve diagnostic lab results",
        "description": "Retrieves quantitative LOINC-coded laboratory observations, reference ranges and abnormal flags for a completed lab requisition.",
        "parameters": [
          {
            "name": "lab_order_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the laboratory order.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Diagnostic laboratory report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabReport"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/claims": {
      "post": {
        "tags": [
          "Claims"
        ],
        "operationId": "submitClaim",
        "summary": "Submit an insurance claim",
        "description": "Submits an institutional or professional medical claim (ICD-10 diagnosis codes and CPT procedure lines) to the clearinghouse.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Submitted insurance claim.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Claim"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claim_id}": {
      "get": {
        "tags": [
          "Claims"
        ],
        "operationId": "getClaimStatus",
        "summary": "Retrieve insurance claim adjudication status",
        "description": "Retrieves payer adjudication status, allowed amount, patient co-pay responsibility and remittance advice codes for a submitted claim.",
        "parameters": [
          {
            "name": "claim_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the insurance claim.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Insurance claim adjudication record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Claim"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of clinical records to return (1-100). Defaults to 25.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "PatientId": {
        "name": "patient_id",
        "in": "path",
        "required": true,
        "description": "Unique UUID identifier of the patient chart.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AppointmentId": {
        "name": "appointment_id",
        "in": "path",
        "required": true,
        "description": "Unique UUID identifier of the clinical appointment.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid clinical payload or missing mandatory field.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid SMART-on-FHIR bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested clinical resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "InsurancePolicy": {
        "type": "object",
        "required": [
          "payer_name",
          "member_id",
          "group_number"
        ],
        "properties": {
          "payer_name": {
            "type": "string"
          },
          "member_id": {
            "type": "string"
          },
          "group_number": {
            "type": "string"
          },
          "plan_type": {
            "type": "string"
          }
        }
      },
      "PatientCreate": {
        "type": "object",
        "required": [
          "given_name",
          "family_name",
          "date_of_birth",
          "biological_sex",
          "insurance_policy"
        ],
        "properties": {
          "given_name": {
            "type": "string"
          },
          "family_name": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date"
          },
          "biological_sex": {
            "type": "string",
            "enum": [
              "female",
              "male",
              "other",
              "unknown"
            ]
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "insurance_policy": {
            "$ref": "#/components/schemas/InsurancePolicy"
          }
        }
      },
      "Patient": {
        "type": "object",
        "required": [
          "id",
          "patient_mrn",
          "given_name",
          "family_name",
          "date_of_birth",
          "biological_sex",
          "insurance_policy",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "patient_mrn": {
            "type": "string"
          },
          "given_name": {
            "type": "string"
          },
          "family_name": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date"
          },
          "biological_sex": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "allergies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "insurance_policy": {
            "$ref": "#/components/schemas/InsurancePolicy"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PatientList": {
        "type": "object",
        "required": [
          "data",
          "total_count"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Patient"
            }
          },
          "total_count": {
            "type": "integer"
          }
        }
      },
      "AppointmentCreate": {
        "type": "object",
        "required": [
          "patient_id",
          "provider_id",
          "department",
          "start_time",
          "duration_minutes",
          "visit_modality"
        ],
        "properties": {
          "patient_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider_id": {
            "type": "string",
            "format": "uuid"
          },
          "department": {
            "type": "string"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "duration_minutes": {
            "type": "integer"
          },
          "visit_modality": {
            "type": "string",
            "enum": [
              "in_person",
              "telehealth"
            ]
          },
          "chief_complaint": {
            "type": "string"
          }
        }
      },
      "Appointment": {
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "provider_id",
          "department",
          "start_time",
          "duration_minutes",
          "visit_modality",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "patient_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider_id": {
            "type": "string",
            "format": "uuid"
          },
          "department": {
            "type": "string"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "duration_minutes": {
            "type": "integer"
          },
          "visit_modality": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "checked_in",
              "completed",
              "cancelled"
            ]
          }
        }
      },
      "AppointmentList": {
        "type": "object",
        "required": [
          "data",
          "total_count"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Appointment"
            }
          },
          "total_count": {
            "type": "integer"
          }
        }
      },
      "DosageInstructions": {
        "type": "object",
        "required": [
          "route",
          "frequency_per_day",
          "duration_days"
        ],
        "properties": {
          "route": {
            "type": "string",
            "enum": [
              "oral",
              "intravenous",
              "subcutaneous",
              "topical"
            ]
          },
          "frequency_per_day": {
            "type": "integer"
          },
          "duration_days": {
            "type": "integer"
          },
          "take_with_food": {
            "type": "boolean"
          }
        }
      },
      "PrescriptionCreate": {
        "type": "object",
        "required": [
          "patient_id",
          "prescriber_id",
          "rxnorm_code",
          "medication_name",
          "dosage_mg",
          "refills_allowed",
          "dosage_instructions"
        ],
        "properties": {
          "patient_id": {
            "type": "string",
            "format": "uuid"
          },
          "prescriber_id": {
            "type": "string",
            "format": "uuid"
          },
          "rxnorm_code": {
            "type": "string"
          },
          "medication_name": {
            "type": "string"
          },
          "dosage_mg": {
            "type": "number"
          },
          "refills_allowed": {
            "type": "integer"
          },
          "pharmacy_ncpdp_id": {
            "type": "string"
          },
          "dosage_instructions": {
            "$ref": "#/components/schemas/DosageInstructions"
          }
        }
      },
      "Prescription": {
        "type": "object",
        "required": [
          "id",
          "patient_id",
          "prescriber_id",
          "rxnorm_code",
          "medication_name",
          "dosage_mg",
          "refills_remaining",
          "status",
